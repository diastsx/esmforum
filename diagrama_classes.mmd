classDiagram
    class Usuario {
        +int idUsuario
        +string nome
    }

    class Pergunta {
        +int idPergunta
        +string texto
    }

    class Resposta {
        +int idResposta
        +string texto
    }

    class Tag {
        +int idTag
        +string nome
    }

    class Notificacao {
        +int idNotificacao
        +boolean lida
        +string mensagem
    }

    Usuario "1" -- "0..*" Pergunta : publica
